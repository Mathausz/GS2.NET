{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/nexusverde-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Oracle": ""
  },

  "Jwt": {
    "Issuer": "NexusVerde.Api",
    "Audience": "NexusVerde.Clients",
    "Key": "",
    "ExpiresMinutes": 60
  },

  "Database": {
    "ApplyMigrationsOnStartup": true,
    "RunSeedOnStartup": false
  },

  "Seed": {
    "AdminNome": "Administrador Nexus Verde",
    "AdminEmail": "",
    "AdminPassword": ""
  },

  "Weather": {
    "BaseUrl": "https://api.open-meteo.com/",
    "TimeoutSeconds": 5
  },

  "Idempotency": {
    "RetentionHours": 24
  },

  "RateLimiting": {
    "Global": { "PermitLimit": 120, "WindowSeconds": 60 },
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Criacao": { "PermitLimit": 20, "WindowSeconds": 60 }
  },

  "Observability": {
    "ConsoleExporter": false,
    "MetricsEnabled": true
  },

  "Swagger": {
    "Enabled": true
  },

  "Cors": {
    "AllowedOrigins": []
  }
}
