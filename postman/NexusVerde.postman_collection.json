              ]
            },
            "description": "Gera uma nova Idempotency-Key a cada envio. Para testar a idempotência use a próxima requisição, que reutiliza a MESMA chave."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('solicitacaoId', j.solicitacao.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Repetir MESMA chave (não duplica; header Idempotency-Replayed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/solicitacoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "solicitacoes"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"regiaoId\": \"{{regiaoId}}\",\n  \"tipo\": \"SemAgua\",\n  \"descricao\": \"Bairro sem abastecimento desde ontem à noite\",\n  \"quantidadePessoas\": 12,\n  \"horasSemAgua\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{cidadaoToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('replay', () => pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'));"
                ]
              }
            }
          ]
