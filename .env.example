# =============================================================================
# Nexus Verde — referência de configuração (NÃO coloque valores reais aqui)
# =============================================================================
# Em Development NADA abaixo é obrigatório: sem configuração, a API sobe com banco
# em memória, dados e usuários de demonstração e chave JWT temporária.
#
# O .NET não lê arquivos .env automaticamente. Use estes nomes como:
#   - user-secrets (desenvolvimento, fica só na sua máquina):
#       dotnet user-secrets set "ConnectionStrings:Oracle" '...' --project src/NexusVerde.WebApi
#     (no user-secrets o separador é ":"; em variáveis de ambiente é "__")
#   - variáveis de ambiente (produção / servidor).
# No PowerShell, use aspas simples em valores com $ ou #.

# --- Banco Oracle (FIAP, Oracle 19c) -----------------------------------------
# Sem esta conexão, em Development a API usa o banco em memória.
# Com ela, a API aplica as migrations sozinha na subida (não precisa rodar o script SQL).
# ConnectionStrings__Oracle=Data Source=oracle.fiap.com.br:1521/ORCL;User Id=SEU_RM;Password=SUA_SENHA;

# Força o modo do banco: true = memória, false = Oracle. Sem valor = automático.
# Database__UseInMemory=false

# --- JWT ----------------------------------------------------------------------
# Obrigatória fora de Development. Em Development, sem ela, é gerada uma chave
# temporária a cada subida (tokens deixam de valer ao reiniciar).
# Mínimo 32 caracteres, aleatória. Gere com:  openssl rand -base64 48
# Jwt__Key=TROQUE-POR-UMA-CHAVE-ALEATORIA-COM-MAIS-DE-32-CARACTERES
# Jwt__ExpiresMinutes=60

# --- Administrador inicial ------------------------------------------------------
# Criado na subida se ainda não existir (necessário no Oracle; no modo em memória
# já existem os usuários de demonstração do appsettings.Development.json).
# Seed__AdminEmail=admin@nexusverde.com
# Seed__AdminPassword=TROQUE-POR-UMA-SENHA-FORTE

# --- Opcionais ------------------------------------------------------------------
# Database__RunSeedOnStartup=true          # regiões/pontos/orientações de demonstração (padrão em Development)
# Database__ApplyMigrationsOnStartup=true  # aplica migrations ao subir (padrão: true)
# Idempotency__RetentionHours=24           # validade da Idempotency-Key em horas (0 = não expira)
# RateLimiting__Global__PermitLimit=120    # requisições por minuto por usuário/IP
# RateLimiting__Auth__PermitLimit=10       # logins/cadastros por minuto por IP
# RateLimiting__Criacao__PermitLimit=20    # criações por minuto por usuário
# Weather__BaseUrl=https://api.open-meteo.com/
# Cors__AllowedOrigins__0=https://meu-front.com
# Observability__ConsoleExporter=true      # imprime traces e métricas do OpenTelemetry no console
# Observability__MetricsEnabled=true       # expõe GET /metrics